{
  "$schema": "vscode://schemas/launch",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ovix-ui (Debug)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "OVIX_DEBUG": "true",
        "OVIX_DB_FOLDER": "ovix-ui",
        "OVIX_LOG_FOLDER": "ovix-ui",
        "OVIX_BIN_FOLDER": "ovix-ui"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run ovix-ui (Postgres)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "OVIX_DEBUG": "true",
        "OVIX_LOG_FOLDER": "ovix-ui",
        "OVIX_BIN_FOLDER": "ovix-ui",
        "OVIX_DB_TYPE": "postgres",
        "OVIX_DB_DSN": "postgres://xui:xuipass@127.0.0.1:5432/xui?sslmode=disable"
      },
      "windows": {
        "env": {
          "OVIX_DEBUG": "true",
          "OVIX_LOG_FOLDER": "ovix-ui",
          "OVIX_BIN_FOLDER": "ovix-ui",
          "OVIX_DB_TYPE": "postgres",
          "OVIX_DB_DSN": "postgres://xui:xuipass@127.0.0.1:5432/xui?sslmode=disable",
          "PATH": "C:\\Program Files\\PostgreSQL\\18\\bin;${env:PATH}"
        }
      },
      "console": "integratedTerminal"
    }
  ]
}